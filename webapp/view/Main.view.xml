<mvc:View
    controllerName="z.anulacion.anulacion.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page
        title="Cancelación de documentos"
        class="customPageBg"
        busy="{viewModel>/busy}"
        busyIndicatorDelay="0">

        <content>
            <VBox class="mainWrapper" renderType="Bare">

                <!-- HERO -->
                <VBox class="heroSection">
                    <HBox justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap">
                        <VBox>
                            <Title
                                text="Gestión de anulación"
                                level="H1"
                                class="heroTitle" />

                            <Text
                                text="Consulta el documento material, valida la cadena relacionada y ejecuta la anulación desde SAP BTP."
                                class="heroSubtitle" />
                        </VBox>

                        <VBox class="heroBadgeBox">
                            <Label
                                text="Estado actual"
                                class="heroBadgeLabel" />

                            <ObjectStatus
                                text="{path:'viewModel>/resultado/Status', formatter:'.formatStatusText'}"
                                state="{viewModel>/resultadoState}"
                                class="heroStatus" />
                        </VBox>
                    </HBox>
                </VBox>

                <!-- BÚSQUEDA -->
                <Panel
                    headerText="Búsqueda de documento"
                    expandable="false"
                    class="modernPanel searchPanel">

                    <VBox class="panelInner">
                        <Label
                            text="Número de documento material"
                            design="Bold"
                            class="fieldLabel" />

                        <Input
                            value="{viewModel>/matDoc}"
                            placeholder="Ej. 5000559774"
                            liveChange=".onMatDocLiveChange"
                            submit=".onBuscarDocumento"
                            width="100%"
                            maxLength="20"
                            class="modernInput" />

                        <OverflowToolbar class="actionToolbar">
                            <ToolbarSpacer />

                            <Button
                                text="Buscar"
                                type="Emphasized"
                                icon="sap-icon://search"
                                press=".onBuscarDocumento"
                                enabled="{= !${viewModel>/busy} }"
                                class="btnPrimary" />

                            <Button
                                text="Anular"
                                type="Reject"
                                icon="sap-icon://decline"
                                press=".onAnularDocumento"
                                enabled="{= ${viewModel>/canCancel} &amp;&amp; !${viewModel>/busy} }"
                                class="btnDanger" />

                            <Button
                                text="Limpiar"
                                icon="sap-icon://refresh"
                                press=".onLimpiar"
                                enabled="{= !${viewModel>/busy} }"
                                class="btnLight" />
                        </OverflowToolbar>
                    </VBox>
                </Panel>

                <!-- RESULTADO GENERAL -->
                <Panel
                    headerText="Resultado general"
                    expandable="false"
                    class="modernPanel resultPanel">

                    <VBox class="panelInner">
                        <HBox
                            alignItems="Center"
                            justifyContent="SpaceBetween"
                            wrap="Wrap">

                            <VBox>
                                <Title
                                    text="Estatus de la operación"
                                    level="H4"
                                    class="sectionTitle" />

                                <Text
                                    text="Resumen de la consulta o anulación ejecutada."
                                    class="sectionSubtitle" />
                            </VBox>

                            <ObjectStatus
                                text="{path:'viewModel>/resultado/Status', formatter:'.formatStatusText'}"
                                state="{viewModel>/resultadoState}"
                                class="resultStatus" />
                        </HBox>

                        <MessageStrip
                            text="{viewModel>/resultado/Message}"
                            type="{= ${viewModel>/resultadoState} === 'Error' ? 'Error' : ${viewModel>/resultadoState} === 'Warning' ? 'Warning' : ${viewModel>/resultadoState} === 'Success' ? 'Success' : 'Information' }"
                            showIcon="true"
                            showCloseButton="false"
                            visible="{= !!${viewModel>/resultado/Message} }"
                            class="resultMessageStrip" />

                        <!-- RESUMEN DE OBJETOS -->
                        <HBox class="summaryGrid" wrap="Wrap">
                            <VBox class="summaryCard">
                                <Text
                                    text="Objetos encontrados"
                                    class="summaryLabel" />

                                <Title
                                    text="{viewModel>/summary/total}"
                                    level="H4"
                                    class="summaryValue" />
                            </VBox>

                            <VBox class="summaryCard">
                                <Text
                                    text="HU"
                                    class="summaryLabel" />

                                <Title
                                    text="{viewModel>/summary/hu}"
                                    level="H4"
                                    class="summaryValue" />
                            </VBox>

                            <VBox class="summaryCard">
                                <Text
                                    text="Documento material"
                                    class="summaryLabel" />

                                <Title
                                    text="{viewModel>/summary/material}"
                                    level="H4"
                                    class="summaryValue" />
                            </VBox>

                            <VBox class="summaryCard">
                                <Text
                                    text="Pedido / entrega / transporte"
                                    class="summaryLabel" />

                                <Title
                                    text="{viewModel>/summary/otros}"
                                    level="H4"
                                    class="summaryValue" />
                            </VBox>
                        </HBox>
                    </VBox>
                </Panel>

                <!-- TABS -->
                <IconTabBar
                    class="modernTabs"
                    expandable="false">

                    <items>

                        <!-- VISTA PREVIA -->
                        <IconTabFilter
                            text="Vista previa"
                            icon="sap-icon://inspect-down"
                            count="{= ${viewModel>/preview}.length }">

                            <VBox class="tabContentBox">
                                <Toolbar class="tableToolbar">
                                    <Title
                                        text="Vista previa de anulación"
                                        level="H4"
                                        class="tableTitle" />

                                    <ToolbarSpacer />
                                </Toolbar>

                                <Table
                                    items="{viewModel>/preview}"
                                    inset="false"
                                    growing="true"
                                    growingThreshold="20"
                                    growingScrollToLoad="true"
                                    width="100%"
                                    class="modernTable"
                                    noDataText="No hay datos de vista previa.">

                                    <columns>
                                        <Column minScreenWidth="Tablet" demandPopin="true">
                                            <Text text="Documento material" />
                                        </Column>

                                        <Column minScreenWidth="Tablet" demandPopin="true">
                                            <Text text="Descripción" />
                                        </Column>

                                        <Column minScreenWidth="Tablet" demandPopin="true">
                                            <Text text="Tipo de objeto" />
                                        </Column>

                                        <Column minScreenWidth="Tablet" demandPopin="true">
                                            <Text text="Referencia 1" />
                                        </Column>

                                        <Column minScreenWidth="Tablet" demandPopin="true">
                                            <Text text="Referencia 2" />
                                        </Column>
                                    </columns>

                                    <items>
                                        <ColumnListItem
                                            vAlign="Middle"
                                            class="tableRowCustom">

                                            <cells>
                                                <ObjectIdentifier
                                                    title="{viewModel>MatDoc}"
                                                    class="matDocId" />

                                                <Text
                                                    text="{viewModel>Message}"
                                                    wrapping="true" />

                                                <Text text="{viewModel>ObjTipo}" />

                                                <Text text="{viewModel>ObjKey1}" />

                                                <Text text="{viewModel>ObjKey2}" />
                                            </cells>
                                        </ColumnListItem>
                                    </items>
                                </Table>
                            </VBox>
                        </IconTabFilter>

                        <!-- DETALLE FINAL -->
                        <IconTabFilter
                            text="Detalle final"
                            icon="sap-icon://detail-view"
                            count="{= ${viewModel>/detalle}.length }">

                            <VBox class="tabContentBox">
                                <Toolbar class="tableToolbar">
                                    <Title
                                        text="Detalle final de anulación"
                                        level="H4"
                                        class="tableTitle" />

                                    <ToolbarSpacer />
                                </Toolbar>

                                <Table
                                    items="{viewModel>/detalle}"
                                    inset="false"
                                    growing="true"
                                    growingThreshold="20"
                                    growingScrollToLoad="true"
                                    width="100%"
                                    class="modernTable"
                                    noDataText="No hay datos de detalle final.">

                                    <columns>
                                        <Column minScreenWidth="Tablet" demandPopin="true">
                                            <Text text="Documento material" />
                                        </Column>

                                        <Column minScreenWidth="Tablet" demandPopin="true">
                                            <Text text="Descripción" />
                                        </Column>

                                        <Column minScreenWidth="Tablet" demandPopin="true">
                                            <Text text="Tipo de objeto" />
                                        </Column>

                                        <Column minScreenWidth="Tablet" demandPopin="true">
                                            <Text text="Referencia 1" />
                                        </Column>

                                        <Column minScreenWidth="Tablet" demandPopin="true">
                                            <Text text="Referencia 2" />
                                        </Column>
                                    </columns>

                                    <items>
                                        <ColumnListItem
                                            vAlign="Middle"
                                            class="tableRowCustom">

                                            <cells>
                                                <ObjectIdentifier
                                                    title="{viewModel>MatDoc}"
                                                    class="matDocId" />

                                                <Text
                                                    text="{viewModel>Message}"
                                                    wrapping="true" />

                                                <Text text="{viewModel>ObjTipo}" />

                                                <Text text="{viewModel>ObjKey1}" />

                                                <Text text="{viewModel>ObjKey2}" />
                                            </cells>
                                        </ColumnListItem>
                                    </items>
                                </Table>
                            </VBox>
                        </IconTabFilter>

                    </items>
                </IconTabBar>

            </VBox>
        </content>
    </Page>
</mvc:View>