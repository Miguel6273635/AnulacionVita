<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog
        id="cancellationConfirmationDialog"
        contentWidth="48rem"
        stretchOnPhone="true"
        draggable="true"
        afterClose=".onAfterCancellationConfirmationClose"
        class="cancellationConfirmDialog">

        <customHeader>
            <Toolbar class="cancellationConfirmHeader">
                <HBox
                    alignItems="Center"
                    class="cancellationConfirmHeaderContent">
                    <VBox
                        alignItems="Center"
                        justifyContent="Center"
                        class="cancellationConfirmHeaderIconBox">
                        <core:Icon
                            src="sap-icon://alert"
                            class="cancellationConfirmHeaderIcon" />
                    </VBox>
                    <Title
                        text="Confirmar anulación"
                        level="H4"
                        class="cancellationConfirmTitle" />
                </HBox>
            </Toolbar>
        </customHeader>

        <content>
            <VBox
                width="100%"
                class="cancellationConfirmContent">

                <VBox
                    width="100%"
                    class="cancellationConfirmHero">
                    <Text
                        text="Se enviará la solicitud de anulación para el documento"
                        wrapping="true"
                        class="cancellationConfirmEyebrow" />
                    <Title
                        text="{viewModel>/confirmationDialog/matDoc}"
                        level="H3"
                        class="cancellationConfirmDocument" />
                    <Text
                        text="{= 'Ejercicio: ' + (${viewModel>/eccPlan/year} || 'pendiente') + ' · Movimiento: ' + (${viewModel>/eccPlan/movementType} || 'pendiente') }"
                        wrapping="true"
                        class="cancellationConfirmDescription" />
                    <Text
                        text="{= ${viewModel>/confirmationDialog/matDocOnly} ? 'Revisa las posiciones confirmadas por ECC. Se enviará un único POST por el documento material completo.' : 'Revisa las HUs, los pedidos y los materiales seleccionados antes de continuar.' }"
                        wrapping="true"
                        class="cancellationConfirmDescription" />
                </VBox>

                <MessageStrip
                    text="Las posiciones seleccionadas provienen del alcance validado por ECC. ECC recibirá el MatDoc completo y los campos HuVenum, HuExidv, ProveedoresSel, EbelnSel y EbelnsSel vacíos."
                    type="Information"
                    showIcon="true"
                    showCloseButton="false"
                    visible="{viewModel>/confirmationDialog/matDocOnly}" />

                <VBox
                    width="100%"
                    visible="{viewModel>/confirmationDialog/matDocOnly}"
                    class="cancellationConfirmSelection">

                    <HBox
                        width="100%"
                        alignItems="Center"
                        class="cancellationConfirmSelectionHeader">
                        <core:Icon
                            src="sap-icon://product"
                            class="cancellationConfirmSelectionIcon" />
                        <VBox width="100%">
                            <Text
                                text="Materiales seleccionados"
                                class="cancellationConfirmSelectionLabel" />
                            <Text
                                text="{= ${viewModel>/confirmationDialog/selectionCount} === 1 ? '1 posición ECC seleccionada' : ${viewModel>/confirmationDialog/selectionCount} + ' posiciones ECC seleccionadas' }"
                                class="cancellationConfirmSelectionValue" />
                        </VBox>
                    </HBox>

                    <VBox
                        width="100%"
                        items="{
                            path: 'viewModel>/confirmationDialog/materialSelections',
                            templateShareable: false
                        }"
                        class="cancellationConfirmSelectionList">
                        <items>
                            <HBox
                                width="100%"
                                alignItems="Center"
                                class="cancellationConfirmSelectionItem">
                                <ObjectStatus
                                    text="{= '#' + ${viewModel>Sequence} }"
                                    state="Information"
                                    class="cancellationConfirmSequence" />
                                <VBox width="100%">
                                    <Text
                                        text="{= ${viewModel>DisplayMatnr} || '-' }"
                                        class="cancellationConfirmMaterial" />
                                    <Text
                                        text="{= (${viewModel>Maktx} || 'Sin nombre disponible') + ' · HU ' + (${viewModel>HuExidv} || ${viewModel>HuVenum} || '-') }"
                                        wrapping="true"
                                        class="cancellationConfirmProviderNumber" />
                                </VBox>
                            </HBox>
                        </items>
                    </VBox>
                </VBox>

                <HBox
                    width="100%"
                    wrap="Wrap"
                    visible="{= !${viewModel>/confirmationDialog/matDocOnly} }"
                    class="cancellationConfirmMetrics">
                    <VBox class="cancellationConfirmMetric cancellationConfirmMetricTotal">
                        <Text text="Objetos" class="cancellationConfirmMetricLabel" />
                        <ObjectNumber
                            number="{viewModel>/confirmationDialog/total}"
                            class="cancellationConfirmMetricValue" />
                    </VBox>
                    <VBox class="cancellationConfirmMetric cancellationConfirmMetricHu">
                        <Text text="HU disponibles" class="cancellationConfirmMetricLabel" />
                        <ObjectNumber
                            number="{viewModel>/confirmationDialog/hu}"
                            class="cancellationConfirmMetricValue" />
                    </VBox>
                    <VBox class="cancellationConfirmMetric cancellationConfirmMetricMaterial">
                        <Text text="HU seleccionadas" class="cancellationConfirmMetricLabel" />
                        <ObjectNumber
                            number="{viewModel>/confirmationDialog/huSeleccionadas}"
                            class="cancellationConfirmMetricValue" />
                    </VBox>
                    <VBox class="cancellationConfirmMetric cancellationConfirmMetricOther">
                        <Text text="Pedidos" class="cancellationConfirmMetricLabel" />
                        <ObjectNumber
                            number="{viewModel>/confirmationDialog/selectionCount}"
                            class="cancellationConfirmMetricValue" />
                    </VBox>
                </HBox>

                <VBox
                    width="100%"
                    visible="{= !${viewModel>/confirmationDialog/matDocOnly} }"
                    class="cancellationConfirmSelection">

                    <HBox
                        width="100%"
                        alignItems="Center"
                        class="cancellationConfirmSelectionHeader">
                        <core:Icon
                            src="sap-icon://shipping-status"
                            class="cancellationConfirmSelectionIcon" />
                        <VBox width="100%">
                            <Text
                                text="Selección preparada"
                                class="cancellationConfirmSelectionLabel" />
                            <Text
                                text="{= ${viewModel>/confirmationDialog/selectionCount} === 1 ? '1 pedido seleccionado' : ${viewModel>/confirmationDialog/selectionCount} + ' pedidos seleccionados' }"
                                class="cancellationConfirmSelectionValue" />
                        </VBox>
                    </HBox>

                    <VBox
                        width="100%"
                        items="{
                            path: 'viewModel>/confirmationDialog/selections',
                            templateShareable: false
                        }"
                        class="cancellationConfirmSelectionList">
                        <items>
                            <VBox
                                width="100%"
                                class="cancellationConfirmSelectionItem">

                                <HBox
                                    width="100%"
                                    alignItems="Start"
                                    class="cancellationConfirmProviderRow">
                                    <VBox width="100%">
                                        <Text
                                            text="Proveedor"
                                            class="cancellationConfirmDetailLabel" />
                                        <Text
                                            text="{= ${viewModel>Name1} || 'Proveedor sin nombre' }"
                                            wrapping="true"
                                            class="cancellationConfirmProviderName" />
                                        <Text
                                            text="{= (${viewModel>Lifnr} || '-') + ' · HU ' + (${viewModel>HuExidv} || ${viewModel>HuVenum} || '-') }"
                                            class="cancellationConfirmProviderNumber" />
                                    </VBox>
                                    <ObjectStatus
                                        text="{= '#' + ${viewModel>Sequence} }"
                                        state="Information"
                                        class="cancellationConfirmSequence" />
                                </HBox>

                                <HBox
                                    width="100%"
                                    alignItems="End"
                                    class="cancellationConfirmSelectionFacts">
                                    <VBox
                                        width="58%"
                                        class="cancellationConfirmFact">
                                        <Text text="Pedido" class="cancellationConfirmDetailLabel" />
                                        <Text text="{= ${viewModel>Ebeln} || '-' }" wrapping="false" class="cancellationConfirmMaterial" />
                                    </VBox>
                                    <VBox
                                        width="42%"
                                        class="cancellationConfirmFact cancellationConfirmQuantityFact">
                                        <Text text="Material" class="cancellationConfirmDetailLabel" />
                                        <Text text="{= ${viewModel>DisplayMatnr} || '-' }" wrapping="false" tooltip="{viewModel>Matnr}" class="cancellationConfirmMaterial" />
                                    </VBox>
                                </HBox>

                            </VBox>
                        </items>
                    </VBox>

                </VBox>

                <HBox
                    width="100%"
                    justifyContent="End"
                    alignItems="Center"
                    class="cancellationConfirmActions">
                    <Button
                        text="Cancelar"
                        type="Transparent"
                        press=".onCloseCancellationConfirmation"
                        class="cancellationConfirmCancelButton" />
                    <Button
                        text="Anular documento"
                        type="Reject"
                        icon="sap-icon://decline"
                        press=".onConfirmCancellation"
                        enabled="{= !${viewModel>/busy} &amp;&amp; !${viewModel>/backendPrevalidationOnly} &amp;&amp; ${viewModel>/backendPlanValidated} }"
                        class="cancellationConfirmSubmitButton" />
                </HBox>

            </VBox>
        </content>

    </Dialog>

</core:FragmentDefinition>
