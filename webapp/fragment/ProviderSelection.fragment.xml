<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog
        id="providerDialog"
        title="Seleccionar proveedor y pedido"
        contentWidth="96rem"
        stretchOnPhone="true"
        draggable="true"
        resizable="true"
        class="providerDialog">

        <content>

            <VBox
                width="100%"
                class="providerDialogContent">

                <!-- =====================================================
                     INFORMACIÓN DE LA HU
                     ===================================================== -->

                <HBox
                    alignItems="Center"
                    width="100%"
                    class="providerDialogHero">

                    <VBox
                        alignItems="Center"
                        justifyContent="Center"
                        class="providerDialogHeroIconBox">

                        <core:Icon
                            src="sap-icon://supplier"
                            class="providerDialogHeroIcon" />

                    </VBox>

                    <VBox
                        width="100%"
                        class="providerDialogHeroText">

                        <Title
                            text="{= 'HU ' + ${viewModel>/providerDialog/huVenum} }"
                            level="H4"
                            class="providerDialogHuTitle" />

                        <Text
                            text="{= 'Identificador: ' + ${viewModel>/providerDialog/huExidv} }"
                            wrapping="true"
                            class="providerDialogHuSubtitle" />

                    </VBox>

                </HBox>


                <!-- =====================================================
                     MENSAJE INFORMATIVO
                     ===================================================== -->

                <MessageStrip
                    text="{viewModel>/providerDialog/infoText}"
                    type="Information"
                    showIcon="true"
                    showCloseButton="false"
                    class="providerDialogInfo" />


                <!-- =====================================================
                     TABLA DE PROVEEDORES
                     SELECCIÓN MÚLTIPLE
                     ===================================================== -->

                <Table
                    id="providerTable"
                    items="{viewModel>/providerDialog/providers}"
                    mode="MultiSelect"
                    includeItemInSelection="true"
                    selectionChange=".onProviderSelectionChange"
                    inset="false"
                    fixedLayout="false"
                    width="100%"
                    class="providerTable"
                    noDataText="No hay combinaciones de proveedor y pedido disponibles.">

                    <columns>

                        <!-- LÍNEA DEL DETALLE PROFUNDO -->

                        <Column
                            width="5rem"
                            hAlign="Center">

                            <Text
                                text="Línea"
                                class="providerTableHeader" />

                        </Column>

                        <!-- PROVEEDOR -->

                        <Column
                            width="9rem"
                            minScreenWidth="Tablet"
                            demandPopin="true">

                            <Text
                                text="Proveedor"
                                class="providerTableHeader" />

                        </Column>


                        <!-- NOMBRE DEL PROVEEDOR -->

                        <Column
                            width="15rem"
                            minScreenWidth="Tablet"
                            demandPopin="true">

                            <Text
                                text="Nombre del proveedor"
                                class="providerTableHeader" />

                        </Column>


                        <!-- PEDIDO DE COMPRA -->

                        <Column
                            width="11rem"
                            minScreenWidth="Tablet"
                            demandPopin="true">

                            <Text
                                text="Pedido de compra"
                                class="providerTableHeader" />

                        </Column>


                        <!-- DOCUMENTO DE MATERIAL / EJERCICIO -->

                        <Column
                            width="10rem"
                            minScreenWidth="Tablet"
                            demandPopin="true">

                            <Text
                                text="Doc. material"
                                class="providerTableHeader" />

                        </Column>


                        <!-- PEDIDO DE VENTAS -->

                        <Column
                            width="10rem"
                            minScreenWidth="Tablet"
                            demandPopin="true">

                            <Text
                                text="Pedido de ventas"
                                class="providerTableHeader" />

                        </Column>


                        <!-- ENTREGA DE SALIDA -->

                        <Column
                            width="10rem"
                            minScreenWidth="Tablet"
                            demandPopin="true">

                            <Text
                                text="Entrega de salida"
                                class="providerTableHeader" />

                        </Column>


                        <!-- LOTE -->

                        <Column
                            width="8rem"
                            minScreenWidth="Tablet"
                            demandPopin="true">

                            <Text
                                text="Lote"
                                class="providerTableHeader" />

                        </Column>


                        <!-- CANTIDAD -->

                        <Column
                            width="7rem"
                            hAlign="End"
                            minScreenWidth="Tablet"
                            demandPopin="true">

                            <Text
                                text="Cantidad"
                                class="providerTableHeader" />

                        </Column>


                        <!-- UNIDAD -->

                        <Column
                            width="6rem"
                            minScreenWidth="Tablet"
                            demandPopin="true">

                            <Text
                                text="Unidad"
                                class="providerTableHeader" />

                        </Column>


                        <!-- MATERIAL -->

                        <Column
                            width="12rem"
                            minScreenWidth="Tablet"
                            demandPopin="true">

                            <Text
                                text="Material"
                                class="providerTableHeader" />

                        </Column>

                    </columns>


                    <!-- =================================================
                         REGISTROS
                         ================================================= -->

                    <items>

                        <ColumnListItem
                            type="Active"
                            selected="{viewModel>selected}"
                            vAlign="Middle"
                            class="providerTableRow">

                            <cells>

                                <!-- SEQNO -->

                                <ObjectNumber
                                    number="{viewModel>SeqNo}"
                                    class="providerSequenceCell" />

                                <!-- PROVEEDOR -->

                                <ObjectIdentifier
                                    title="{viewModel>Lifnr}"
                                    class="providerIdCell" />


                                <!-- NOMBRE DEL PROVEEDOR -->

                                <Text
                                    text="{viewModel>Name1}"
                                    wrapping="true"
                                    tooltip="{viewModel>Name1}"
                                    class="providerNameCell" />


                                <!-- PEDIDO DE COMPRA -->

                                <Text
                                    text="{viewModel>Ebeln}"
                                    class="providerOrderCell" />


                                <!-- DOCUMENTO DE MATERIAL / EJERCICIO -->

                                <VBox class="providerDocumentCell">
                                    <Text
                                        text="{= ${viewModel>GrMatDoc} || '-' }"
                                        wrapping="false"
                                        class="providerDetailCell providerOrderCell" />
                                    <Text
                                        text="{= ${viewModel>GrYear} ? 'Ejercicio ' + ${viewModel>GrYear} : '' }"
                                        visible="{= !!${viewModel>GrYear} }"
                                        class="providerDocumentYear" />
                                </VBox>


                                <!-- PEDIDO DE VENTAS -->

                                <Text
                                    text="{= ${viewModel>SoVbeln} || '-' }"
                                    wrapping="false"
                                    class="providerDetailCell providerSalesOrderCell" />


                                <!-- ENTREGA DE SALIDA -->

                                <Text
                                    text="{= ${viewModel>DelivVbeln} || '-' }"
                                    wrapping="false"
                                    class="providerDetailCell providerDeliveryCell" />


                                <!-- LOTE -->

                                <Text
                                    text="{= ${viewModel>Charg} || '-' }"
                                    wrapping="true"
                                    class="providerDetailCell providerBatchCell" />


                                <!-- CANTIDAD -->

                                <Text
                                    text="{= ${viewModel>Menge} || '-' }"
                                    wrapping="true"
                                    textAlign="End"
                                    class="providerDetailCell providerQuantityCell" />


                                <!-- UNIDAD -->

                                <Text
                                    text="{= ${viewModel>Meins} || '-' }"
                                    wrapping="true"
                                    class="providerDetailCell providerUnitCell" />


                                <!-- MATERIAL -->

                                <Text
                                    text="{= ${viewModel>Matnr} || '-' }"
                                    wrapping="true"
                                    class="providerDetailCell providerMaterialCell" />

                            </cells>

                        </ColumnListItem>

                    </items>

                </Table>


                <!-- =====================================================
                     BOTONES DEL POPUP
                     YA NO USAMOS beginButton / endButton
                     ===================================================== -->

                <HBox
                    width="100%"
                    justifyContent="End"
                    alignItems="Center"
                    wrap="Wrap"
                    class="providerDialogActions">

                    <!-- CANCELAR -->

                    <Button
                        text="Cancelar"
                        type="Transparent"
                        icon="sap-icon://decline"
                        press=".onCloseProviderDialog"
                        class="providerDialogCancel" />


                    <!-- CONFIRMAR -->

                    <Button
                        text="Confirmar selección"
                        type="Emphasized"
                        icon="sap-icon://accept"
                        enabled="{viewModel>/providerDialog/canConfirm}"
                        press=".onConfirmProviderSelection"
                        class="providerDialogConfirm" />

                </HBox>

            </VBox>

        </content>

    </Dialog>

</core:FragmentDefinition>
